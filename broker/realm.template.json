{
  "realm": "t27os-telegram",
  "enabled": true,
  "sslRequired": "all",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 120,
  "ssoSessionIdleTimeout": 300,
  "ssoSessionMaxLifespan": 600,
  "clients": [
    {
      "clientId": "t27os-telegram-native",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://127.0.0.1/t27os-telegram-callback"
      ],
      "webOrigins": [],
      "defaultClientScopes": [],
      "optionalClientScopes": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "id.token.signed.response.alg": "RS256",
        "use.refresh.tokens": "false"
      },
      "protocolMappers": [
        {
          "name": "Verified Telegram subject in native ID token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "config": {
            "user.session.note": "sub",
            "claim.name": "telegram_sub",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "false"
          }
        },
        {
          "name": "Verified identity provider in native ID token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "config": {
            "user.session.note": "identity_provider",
            "claim.name": "identity_provider",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "false"
          }
        },
        {
          "name": "Optional Telegram display name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "config": {
            "user.session.note": "name",
            "claim.name": "telegram_name",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "false"
          }
        },
        {
          "name": "Optional Telegram display preferred_username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "config": {
            "user.session.note": "preferred_username",
            "claim.name": "telegram_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "false"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "telegram",
      "displayName": "Telegram",
      "providerId": "oidc",
      "enabled": false,
      "trustEmail": false,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "telegram-create-unique-only",
      "config": {
        "issuer": "https://oauth.telegram.org",
        "authorizationUrl": "https://oauth.telegram.org/auth",
        "tokenUrl": "https://oauth.telegram.org/token",
        "jwksUrl": "https://oauth.telegram.org/.well-known/jwks.json",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "disableUserInfo": "true",
        "disableNonce": "false",
        "clientAuthMethod": "client_secret_basic",
        "defaultScope": "openid profile",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "syncMode": "FORCE",
        "isAccessTokenJWT": "false",
        "clientId": "${T27_TELEGRAM_OIDC_CLIENT_ID}",
        "clientSecret": "${T27_TELEGRAM_OIDC_CLIENT_SECRET}"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "Telegram subject to broker session note",
      "identityProviderAlias": "telegram",
      "identityProviderMapper": "oidc-user-session-note-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "claims": "[{\"key\":\"sub\",\"value\":\"^[!-~]{1,255}$\"},{\"key\":\"name\",\"value\":\"^[^\\\\p{Cc}\\\\p{Cf}]{1,80}$\"},{\"key\":\"preferred_username\",\"value\":\"^[A-Za-z0-9_]{1,64}$\"}]",
        "are.claim.values.regex": "true"
      }
    },
    {
      "name": "Telegram stable broker username",
      "identityProviderAlias": "telegram",
      "identityProviderMapper": "oidc-username-idp-mapper",
      "config": {
        "syncMode": "IMPORT",
        "template": "${ALIAS}.${CLAIM.sub}",
        "target": "LOCAL"
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "telegram-create-unique-only",
      "description": "Create a new broker user only when no conflicting user exists",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-create-user-if-unique",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "telegram-only-browser",
      "description": "Fresh Telegram broker authentication with no cookie or password execution",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "identity-provider-redirector",
          "authenticatorConfig": "telegram-only-default",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "browserFlow": "telegram-only-browser",
  "authenticatorConfig": [
    {
      "alias": "telegram-only-default",
      "config": {
        "defaultProvider": "telegram"
      }
    }
  ]
}
